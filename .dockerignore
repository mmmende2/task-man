# The build context is the repo root (npm workspace root), but cli/Dockerfile
# only COPYs specific manifests + source paths. Everything below is either
# never copied or rebuilt inside the image — excluding it keeps the context
# upload to KB-scale (it currently ships the whole repo, incl. .git).
.git
.github
.claude
docs
deploy
node_modules
**/node_modules
cli/dist
cli/dist-web
web/dist
**/*.md
