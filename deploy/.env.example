# Copy to .env (same directory) and fill in. Never commit the real .env.

# Tunnel token — Zero Trust → Networks → Tunnels → your tunnel.
TUNNEL_TOKEN=

# Origin-side Access JWT verification (both required together).
# Team domain: Zero Trust → Settings → Custom Pages ("team domain"),
#   e.g. "myteam" or "myteam.cloudflareaccess.com".
# AUD tag: Zero Trust → Access → Applications → task-man → Overview →
#   "Application Audience (AUD) Tag".
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# ── Authorization (identity-scoped tasks) ──────────────────────────────
# Every authenticated identity sees only its own tasks. These two settings
# handle the edges of that rule.

# Who owns the pre-authorization tasks (owner: null in tasks.json). Set this
# to YOUR Access login email or your existing tasks are invisible to everyone.
TASK_MAN_DEFAULT_OWNER=

# Maps service tokens (headless MCP) to the person they act for, as
# comma-separated <token common name>=<email> pairs. The common name is the
# "Client ID" name shown at Zero Trust → Access → Service Auth → Service
# Tokens (looks like "<name>.<team>.access").
# A service token that is not mapped here gets 403 even though Access lets
# it through — set this or MCP remote mode will not work.
# Example: TASK_MAN_AGENTS=mcp.myteam.access=you@example.com
TASK_MAN_AGENTS=

# Your IANA timezone — REQUIRED for correct dates. The server computes
# "today" (metrics, day reports) in its own local time; containers default
# to UTC, which makes evening completions land on tomorrow's date and
# vanish from the web Metrics page. Examples: America/Los_Angeles,
# America/Denver, America/Chicago, America/New_York.
TZ=

# ── Landing page + signup (the `landing` service) ──────────────────────
# Three groups, each all-or-nothing: set every var in a group, or none of
# them. A PARTIAL group fails startup on purpose rather than running
# half-configured — see landing/src/env.ts for the exact messages, and
# docs/landing-signup-handoff.md for where each value comes from.

# CAPTCHA on the signup form. The one group you cannot skip: with neither
# var set, the container refuses to boot. (env.ts names an
# SIGNUP_ALLOW_NO_CAPTCHA=1 escape hatch — it is dev-only, and compose
# deliberately does not pass it through, so a droplet can't go live
# without CAPTCHA.) Cloudflare → Turnstile → add site for your domain.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email notification of new signups. Leave all three blank to record
# signups to disk without sending mail. PRODUCT_URL is also what puts the
# "Open the app" links on the landing page — blank hides them rather than
# pointing them nowhere.
RESEND_API_KEY=
SIGNUP_NOTIFY_TO=
PRODUCT_URL=

# One-click approve/deny links in the notification email, which add the
# approved address to a Cloudflare Access group. Leave all five blank to
# approve by hand in the Zero Trust dashboard instead.
# CF_API_TOKEN is scoped: Account → Access: Organizations, Identity
# Providers, and Groups → Edit, this account only.
# LANDING_PUBLIC_URL fixes the origin baked into those links so a spoofed
# request Host header can't redirect them; it is not derived per-request.
SIGNUP_HMAC_SECRET=
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ACCESS_GROUP_ID=
LANDING_PUBLIC_URL=
